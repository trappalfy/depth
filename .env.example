# Optional. Enables the WalletConnect option, which is how mobile wallets
# connect — they have no browser extension for EIP-6963 to discover.
#
# Obtain one at https://dashboard.reown.com by registering your own account.
# Depth does not ship a project id: it identifies the operator, not the app.
# Leave unset and the WalletConnect row simply is not offered.
NEXT_PUBLIC_WC_PROJECT_ID=

# Optional. Overrides the public Robinhood Chain RPC used for server reads.
RPC_URL=
